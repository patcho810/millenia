    {
      "id": "file:src/pipeline/executor.ts",
      "type": "file",
      "title": "src/pipeline/executor.ts",
      "summary": "图像处理流水线的核心执行引擎。",
      "description": "该文件负责协调图像转换的各个阶段，包括缩放、预处理、调色板生成、颜色量化、分块处理和抖动。它按顺序调用各个算法模块，并将结果整合到最终的 ImageData 中。",
      "tags": [
        "pipeline",
        "executor",
        "image-processing",
        "typescript"
      ],
      "complexity": "moderate",
      "name": "executor.ts"
    },
    {
      "id": "function:src/pipeline/executor.ts:executePipeline",
      "type": "function",
      "title": "executePipeline",
      "summary": "执行完整的图像处理流水线。",
      "description": "这是主入口函数，接收源图像、目标画布和配置阶段。它计算显示尺寸，依次运行 scale、preprocess、palette、palette-post、quantize、block 和 dither 阶段。最后将处理后的 ImageData 返回并绘制到画布上。",
      "tags": [
        "entry-point",
        "async"
      ],
      "complexity": "moderate",
      "name": "executePipeline"
    },
    {
      "id": "file:src/pipeline/stages/palette.ts",
      "type": "file",
      "title": "src/pipeline/stages/palette.ts",
      "summary": "调色板生成算法实现模块。",
      "description": "包含多种从图像中提取代表性颜色的算法实现，如中值切割（Median Cut）和 Wu 快速量化算法。这些算法用于生成后续量化阶段所需的调色板。",
      "tags": [
        "palette",
        "algorithm",
        "quantization"
      ],
      "complexity": "moderate",
      "name": "palette.ts"
    },
    {
      "id": "function:src/pipeline/stages/palette.ts:medianCutPalette",
      "type": "function",
      "title": "medianCutPalette",
      "summary": "中值切割算法生成调色板。",
      "description": "通过递归地在颜色空间范围最大的轴上切割颜色簇，直到达到目标颜色数量，最后取每个簇的平均值作为调色板颜色。",
      "tags": [
        "algorithm",
        "median-cut"
      ],
      "complexity": "moderate",
      "name": "medianCutPalette"
    },
    {
      "id": "function:src/pipeline/stages/palette.ts:wuQuantize",
      "type": "function",
      "title": "wuQuantize",
      "summary": "Wu 快速颜色量化算法。",
      "description": "基于 Xiaolin Wu 的算法实现，使用 3D 直方图和前缀和（Moments）来快速计算最优切割位置，以最小化方差误差。适用于生成高质量的索引颜色调色板。",
      "tags": [
        "algorithm",
        "wu-quantize"
      ],
      "complexity": "moderate",
      "name": "wuQuantize"
    },
